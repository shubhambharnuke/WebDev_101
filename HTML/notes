    <nav aria-label="primary navigation">
        more than 1 may be there
        should be labelled
    </nav>
    <section id="1">
        should have id 
        may be more than two
    </section>

    <article>  
    </article>

    <details>
        <summary>the text that will show up with an arrow</summary>
        <p>the text that will come when we click on summary tag</p>
    </details>

    <mark>this will highlight the text in between the tags</mark>
</semantic_tags>

